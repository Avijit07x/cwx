{
  "name": "layout-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D electrical-room layout editor: React, TypeScript, three.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && vite build",
    "knip": "knip",
    "prepare": "husky",
    "assets:fetch": "node scripts/fetch-model.ts",
    "assets:optimize": "node scripts/optimize-model.ts",
    "assets:inspect": "node scripts/inspect-model.ts",
    "measure:fps": "node scripts/measure-fps.ts",
    "measure:bench": "node scripts/measure-bench.ts",
    "measure:domain": "vitest bench --run --project='node (bench)' --reporter=default"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-virtual": "3.14.21",
    "clsx": "2.1.1",
    "i18next": "26.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "5.3.3",
    "sonner": "2.0.8",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "knip": "6.42.0",
    "lint-staged": "17.6.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
